# transient / local
.claude/scheduled_tasks.lock
.claude/*.lock
__pycache__/
*.pyc

# Claude local / machine-specific config (personal paths, per-machine perms)
.claude/settings.local.json
.claude/settings.*.local.json
.claude/tmp/
.claude/cache/

# large reference-conversion data (kept local, not tracked)
/참조문서/

# hwpx-yaml pipeline / web app runtime artifacts (may contain filled personal data)
/hwpx_yaml_out/
/webapp/data/
/webapp/**/__pycache__/

# uvicorn runtime logs
/webapp/uvicorn.*.log
